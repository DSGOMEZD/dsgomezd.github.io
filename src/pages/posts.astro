                  <span class="ext-icon">&#128279;</span>
                  Modelo MERE — Lucidchart
                </a>
              </div>

              <!-- ── Entregables Transversales -->
              <div class="phases">
                <div class="phase">
                  <div class="phase-hdr">Entregables Transversales</div>
                  <div class="file-list phase-files">

                    <div class="file-row">
                      <span class="ftype pdf">PDF</span>
