                      <div class="fbtns">
                        <button class="btn-prev" data-src="/evidencias/07-proyecto/PROYECTO_FINAL_BD1/Entregables%20Transversales/Acta%20de%20Constituci%C3%B3n%20UB-Deporte.pdf">Vista Previa</button>
                        <a class="btn-dl" href="/evidencias/07-proyecto/PROYECTO_FINAL_BD1/Entregables%20Transversales/Acta%20de%20Constituci%C3%B3n%20UB-Deporte.pdf" download>↓ Descargar</a>
