<script>
  document.addEventListener("DOMContentLoaded", () => {
    const pc = document.querySelector(".page-content");
    if (pc) pc.classList.add("visible");
    document.querySelectorAll(".posts-header-animate, .posts-content-animate")
      .forEach((el) => el.classList.add("visible"));

    document.querySelectorAll(".ev-hdr").forEach((btn) => {
      btn.addEventListener("click", () => {
        btn.closest(".ev-card")?.classList.toggle("open");
      });
    });

    // Abrir la tarjeta enlazada por #id (p. ej. /posts#proyecto)
    const target = location.hash && document.querySelector(`.ev-card${location.hash}`);
    if (target) {
      target.classList.add("open");
      setTimeout(() => target.scrollIntoView({ behavior: "smooth", block: "start" }), 150);
    }
  });
</script>
