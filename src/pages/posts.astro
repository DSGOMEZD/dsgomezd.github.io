---
import fs from "node:fs";
import path from "node:path";
import "../styles/home.css";
import "../styles/posts.css";
import "../styles/page-transitions.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import SqlPreview from "../components/SqlPreview.astro";
import PdfPreview from "../components/PdfPreview.astro";
import DocCard from "../components/DocCard.astro";

const PUBLIC_DIR = path.join(process.cwd(), "public");

function sqlPreview(relPath: string, lines = 14) {
  const filePath = path.join(PUBLIC_DIR, relPath);
  const content = fs.readFileSync(filePath, "utf-8");
  const allLines = content.split("\n");
  let preview = allLines.slice(0, lines).join("\n").trimEnd();
  if (allLines.length > lines) preview += "\n...";
  return { preview, totalLines: allLines.length, url: "/" + relPath };
}

function pdfInfo(relPath: string) {
  const filePath = path.join(PUBLIC_DIR, relPath);
  const stat = fs.statSync(filePath);
  const sizeMB = stat.size / (1024 * 1024);
  const size = sizeMB >= 1 ? `${sizeMB.toFixed(1)} MB` : `${Math.round(stat.size / 1024)} KB`;
  return { url: "/" + relPath, size };
}

const repasoSql = sqlPreview("evidencias/bd2/01-repaso-sql/REPASO_SQL.sql");
const avanzadoSql = sqlPreview("evidencias/bd2/02-sql-avanzado/SQL_AVANZADO.sql");
const transaccionesSql = sqlPreview("evidencias/bd2/03-transacciones/TRANSACCIONES.sql");
const optimizacionSql = sqlPreview("evidencias/bd2/04-optimizacion-indices/OPTIMIZACION.sql");
const indexacionSql = sqlPreview("evidencias/bd2/04-optimizacion-indices/INDEXACION.sql");
const tallerSql = sqlPreview("evidencias/bd2/05-talleres/SQL_completos.sql", 16);
const tallerPdf = pdfInfo("evidencias/bd2/05-talleres/Taller_BD2_MercaAndes_Respuestas.pdf");
// ── Proyecto final MotoGo ──────────────────────────────────
const P = "evidencias/bd2/08-proyecto";
const proyecto = {
  github: "https://github.com/DSGOMEZD/PROYECTO-BD2",
  videoId: "XST3REPmFmA",
  zip: pdfInfo(`${P}/Entrega_Proyecto_BD2_MotoGo.zip`),
  erImg: `/${P}/modelado/Modelo_Entidad_Relacion.jpg`,
};

const doc = (file: string, title: string, desc: string, icon: string) => ({
  ...pdfInfo(`${P}/${file}`), title, desc, icon,
});

const grupos = [
  {
    nombre: "Gestión del proyecto",
    accent: "#fb923c",
    docs: [
      doc("gestion/Propuesta_Proyecto.pdf", "Propuesta de proyecto", "Problema, objetivos, alcance y resultados esperados de la plataforma MotoGo.", "🎯"),
      doc("gestion/Supuestos.pdf", "Supuestos", "Reglas de negocio, operativas y tecnológicas sobre las que se diseñó el sistema.", "📌"),
      doc("gestion/Metodologia_Scrum.pdf", "Metodología — Scrum", "Justificación de Scrum, roles, eventos y planificación de sprints semanales.", "🔄"),
      doc("gestion/Organizacion_Equipo.pdf", "Organización del equipo", "Roles, responsabilidades por capa y matriz RACI del equipo de tres integrantes.", "👥"),
      doc("gestion/Gestion_Riesgos.pdf", "Gestión de riesgos", "Identificación, evaluación y plan de respuesta a los riesgos técnicos y del equipo.", "⚠️"),
    ],
  },
  {
    nombre: "Análisis técnico",
    accent: "#38bdf8",
    docs: [
      doc("analisis/Analisis_Seleccion_RDBMS.pdf", "Selección del RDBMS", "Comparación ponderada de MySQL, PostgreSQL y MariaDB con seguridad como criterio principal.", "🗄️"),
      doc("analisis/Analisis_Seleccion_SO.pdf", "Selección del sistema operativo", "Evaluación de distribuciones Linux para las máquinas virtuales de los motores.", "🐧"),
    ],
  },
  {
    nombre: "Modelado de datos",
    accent: "#10b981",
    docs: [
      doc("modelado/Modelo_Relacional.pdf", "Modelo relacional", "Esquema relacional normalizado (3FN) de la base alquiler_motos.", "🔗"),
      doc("modelado/Modelo_Reducido_Tablas.pdf", "Modelo reducido a tablas", "Transformación del modelo E-R a tablas, llaves primarias y foráneas.", "📋"),
      doc("modelado/Diccionario_Datos.pdf", "Diccionario de datos", "Las 7 tablas y 67 columnas documentadas: tipos, restricciones y origen de cada llave.", "📖"),
    ],
  },
  {
    nombre: "Cierre",
    accent: "#a78bfa",
    docs: [
      doc("informe/Informe_Ejecutivo_Final.pdf", "Informe ejecutivo final", "Resumen de lo realmente construido: arquitectura, despliegue, resultados y aprendizajes.", "🏁"),
    ],
  },
];
const totalDocs = grupos.reduce((n, g) => n + g.docs.length, 0);

const fase1 = [
  doc("fase-1/MotoGo_Sistema_Gestion_Alquiler_Motocicletas.pdf", "Sistema de gestión — Fase 1", "Planteamiento inicial del problema y objetivos del sistema.", "📝"),
  doc("fase-1/MotoGo_Supuestos_Desarrollo_Proyecto.pdf", "Supuestos — Fase 1", "Primera versión de los supuestos del proyecto.", "📝"),
  doc("fase-1/Modelo_de_datos_BD2.pdf", "Modelo de datos — Fase 1", "Primer modelo de datos, antes de los ajustes de la entrega final.", "📝"),
];

const stack = ["MySQL 8", "MongoDB 7", "Spring Boot", "Lubuntu", "VirtualBox", "Docker", "Tailscale VPN", "Scrum · Jira"];
const equipo = [
  { nombre: "David Santiago Gómez", rol: "Base de datos relacional · Scrum · Frontend" },
  { nombre: "Gabriel Amórtegui", rol: "Backend e integración web" },
  { nombre: "Daniel Nieto", rol: "MongoDB · Infraestructura Linux" },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Contenido — Bases de Datos II</title>
  </head>

  <body>
    <Navigation />

    <main class="posts-page">
      <div class="posts-container page-content">

        <div class="posts-header posts-header-animate">
          <h1 class="posts-title">Contenido BD II</h1>
          <p class="posts-subtitle">Bases de Datos II · Universidad del Bosque · 2025-2</p>
        </div>

        <div class="ev-grid posts-content-animate">

          <!-- ══ 01 REPASO SQL ═════════════════════════════════ -->
          <section class="ev-card" id="sql-repaso">
            <button class="ev-hdr" style="--mc:#10b981">
              <span class="ev-badge">01</span>
              <span class="ev-ttl">Repaso SQL</span>
              <span class="ev-count">1 script SQL</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Repaso de SQL fundamental sobre el esquema HR de Oracle: SELECT, WHERE, NULL,
                funciones de texto/numéricas/fecha, agregaciones, GROUP BY/HAVING, todos los
                tipos de JOIN (INNER, LEFT, RIGHT, FULL, SELF, CROSS), CASE, DECODE, subconsultas,
                EXISTS/IN, operadores de conjuntos (UNION, INTERSECT, MINUS) y vistas.
              </p>
              <SqlPreview preview={repasoSql.preview} totalLines={repasoSql.totalLines} url={repasoSql.url} />
            </div>
          </section>

          <!-- ══ 02 SQL AVANZADO ═══════════════════════════════ -->
          <section class="ev-card" id="sql-avanzado">
            <button class="ev-hdr" style="--mc:#38bdf8">
              <span class="ev-badge">02</span>
              <span class="ev-ttl">SQL Avanzado</span>
              <span class="ev-count">1 script SQL</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Expresiones de tabla comunes (CTE) simples y recursivas, funciones de ventana
                (ROW_NUMBER, RANK, DENSE_RANK, LAG/LEAD), acumulados y promedios móviles,
                RATIO_TO_REPORT, PERCENT_RANK, CUME_DIST y NTILE, jerarquías con CONNECT BY,
                PIVOT, LISTAGG, FETCH WITH TIES y MERGE, comparando soluciones con subconsultas
                frente a funciones analíticas.
              </p>
              <SqlPreview preview={avanzadoSql.preview} totalLines={avanzadoSql.totalLines} url={avanzadoSql.url} />
            </div>
          </section>

          <!-- ══ 03 TRANSACCIONES ══════════════════════════════ -->
          <section class="ev-card" id="transacciones">
            <button class="ev-hdr" style="--mc:#f472b6">
              <span class="ev-badge">03</span>
              <span class="ev-ttl">Transacciones</span>
              <span class="ev-count">1 script SQL</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Control transaccional en Oracle: COMMIT, ROLLBACK y SAVEPOINT, niveles de
                aislamiento READ COMMITTED y SERIALIZABLE, transacciones READ ONLY,
                SELECT ... FOR UPDATE con NOWAIT/WAIT, y prácticas de bloqueos, concurrencia
                y deadlocks usando dos sesiones simultáneas.
              </p>
              <SqlPreview preview={transaccionesSql.preview} totalLines={transaccionesSql.totalLines} url={transaccionesSql.url} />
            </div>
          </section>

          <!-- ══ 04 OPTIMIZACIÓN E INDEXACIÓN ══════════════════ -->
          <section class="ev-card" id="indexacion">
            <button class="ev-hdr" style="--mc:#fb923c">
              <span class="ev-badge">04</span>
              <span class="ev-ttl">Optimización e Indexación de Consultas</span>
              <span class="ev-count">2 scripts SQL</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Cómo el motor ejecuta las consultas por dentro: EXPLAIN PLAN y DBMS_XPLAN,
                costo y cardinalidad (E-Rows/A-Rows), GATHER_PLAN_STATISTICS, SARGabilidad,
                JOIN vs subconsulta, EXISTS, UNION vs UNION ALL. Y del lado de índices: simples,
                compuestos, function-based, selectividad, estadísticas con DBMS_STATS, índices
                invisibles y medición de rendimiento antes/después.
              </p>
              <SqlPreview label="SQL · Optimización" preview={optimizacionSql.preview} totalLines={optimizacionSql.totalLines} url={optimizacionSql.url} />
              <SqlPreview label="SQL · Indexación" preview={indexacionSql.preview} totalLines={indexacionSql.totalLines} url={indexacionSql.url} />
            </div>
          </section>

          <!-- ══ 05 TALLERES ═══════════════════════════════════ -->
          <section class="ev-card" id="talleres">
            <button class="ev-hdr" style="--mc:#a78bfa">
              <span class="ev-badge">05</span>
              <span class="ev-ttl">Talleres</span>
              <span class="ev-count">1 script + 1 PDF</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Taller integrador MercaAndes: control de concurrencia aplicado (actualizaciones
                perdidas, bloqueo pesimista con SELECT ... FOR UPDATE, niveles de aislamiento)
                resuelto sesión por sesión, con las respuestas razonadas de cada ejercicio y el
                documento de entrega del taller.
              </p>
              <SqlPreview label="SQL · Taller MercaAndes" preview={tallerSql.preview} totalLines={tallerSql.totalLines} url={tallerSql.url} />
              <PdfPreview title="Taller BD2 MercaAndes — Respuestas" url={tallerPdf.url} size={tallerPdf.size} />
            </div>
          </section>

          <!-- ══ 06 NOSQL Y MONGODB ════════════════════════════ -->
          <section class="ev-card" id="nosql-mongodb">
            <button class="ev-hdr" style="--mc:#34d399">
              <span class="ev-badge">06</span>
              <span class="ev-ttl">NoSQL y MongoDB</span>
              <span class="ev-count">Próximamente</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Panorama general del ecosistema NoSQL (Teorema CAP, BASE vs ACID, tipos de bases
                documentales, clave-valor, columnares y grafos) junto con MongoDB en la práctica:
                CRUD completo sobre documentos BSON y pipelines de agregación ($match, $group,
                $project, $lookup, $unwind). Se cubre hacia el final del semestre.
              </p>
              <div class="placeholder-msg">
                <span class="placeholder-icon">📂</span>
                <p>Contenido próximamente — las evidencias se agregarán durante el semestre.</p>
              </div>
            </div>
          </section>

          <!-- ══ 07 PL/SQL ══════════════════════════════════════ -->
          <section class="ev-card" id="plsql">
            <button class="ev-hdr" style="--mc:#facc15">
              <span class="ev-badge">07</span>
              <span class="ev-ttl">PL/SQL y Programación de Bases de Datos</span>
              <span class="ev-count">Próximamente</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Programación procedural dentro del motor de base de datos: bloques PL/SQL
                anónimos, stored procedures con parámetros IN/OUT/IN-OUT, funciones almacenadas,
                cursores explícitos e implícitos, triggers BEFORE/AFTER para auditoría y
                validación, manejo de excepciones y organización en paquetes. Implementación en Oracle.
              </p>
              <div class="placeholder-msg">
                <span class="placeholder-icon">📂</span>
                <p>Contenido próximamente — las evidencias se agregarán durante el semestre.</p>
              </div>
            </div>
          </section>

          <!-- ══ 08 PROYECTO FINAL BD2 ═════════════════════════ -->
          <section class="ev-card ev-card-proyecto" id="proyecto">
            <button class="ev-hdr ev-hdr-proyecto">
              <span class="ev-badge ev-badge-proyecto">08</span>
              <span class="ev-ttl">Proyecto Final — MotoGo</span>
              <span class="ev-count">Entrega final · {totalDocs} docs + video</span>
              <span class="ev-chevron ev-chevron-proyecto">▼</span>
            </button>
            <div class="ev-body">

              <!-- Resumen + acciones -->
              <div class="pj-hero">
                <div class="pj-hero-text">
                  <span class="pj-kicker">Proyecto integrador · Bases de Datos II</span>
                  <h3 class="pj-name">MotoGo</h3>
                  <p class="pj-tagline">
                    Sistema web para la gestión y el alquiler flexible de motocicletas entre
                    propietarios y repartidores. Combina una base relacional en <strong>MySQL</strong>
                    (usuarios, motos, contratos y pagos con lógica en triggers, procedimientos y
                    funciones) con <strong>MongoDB</strong> para la auditoría e historial de actividad,
                    desplegadas en dos máquinas virtuales Linux conectadas por VPN.
                  </p>
                  <div class="pj-chips">
                    {stack.map((t) => <span class="pj-chip">{t}</span>)}
                  </div>
                </div>
                <div class="pj-actions">
                  <a href={proyecto.github} target="_blank" rel="noopener" class="pj-btn pj-btn-gh">
                    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                    Ver código en GitHub
                  </a>
                  <a href={`https://youtu.be/${proyecto.videoId}`} target="_blank" rel="noopener" class="pj-btn pj-btn-yt">
                    ▶ Video en YouTube
                  </a>
                  <a href={proyecto.zip.url} download class="pj-btn pj-btn-zip">
                    ⬇ Descargar entrega (.zip · {proyecto.zip.size})
                  </a>
                </div>
              </div>

              <!-- Video demostrativo -->
              <h4 class="pj-section">🎬 Video demostrativo</h4>
              <div class="pj-video">
                <iframe
                  src={`https://www.youtube.com/embed/${proyecto.videoId}`}
                  title="MotoGo — video demostrativo"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>

              <!-- Equipo -->
              <h4 class="pj-section">👥 Equipo</h4>
              <div class="pj-team">
                {equipo.map((m) => (
                  <div class="pj-member">
                    <span class="pj-avatar">{m.nombre.split(" ").filter((_, i, a) => i === 0 || i === a.length - 1).map((w) => w[0]).join("")}</span>
                    <div>
                      <strong>{m.nombre}</strong>
                      <span>{m.rol}</span>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Modelo E-R -->
              <h4 class="pj-section">🧩 Modelo Entidad–Relación</h4>
              <a href={proyecto.erImg} target="_blank" rel="noopener" class="pj-er">
                <img src={proyecto.erImg} alt="Modelo entidad-relación de MotoGo" loading="lazy" />
                <span class="pj-er-hint">Clic para ver en tamaño completo ↗</span>
              </a>

              <!-- Entregables por grupo -->
              {grupos.map((g) => (
                <div class="pj-group" style={`--accent:${g.accent}`}>
                  <h4 class="pj-section pj-group-title">
                    {g.nombre}
                    <span class="pj-group-count">{g.docs.length}</span>
                  </h4>
                  <div class="pj-docs">
                    {g.docs.map((d) => <DocCard title={d.title} desc={d.desc} url={d.url} size={d.size} icon={d.icon} />)}
                  </div>
                </div>
              ))}

              <!-- Versiones iniciales -->
              <details class="pj-fase1" style="--accent:#64748b">
                <summary>📁 Versiones iniciales — Fase 1 ({fase1.length} documentos)</summary>
                <div class="pj-docs">
                  {fase1.map((d) => <DocCard title={d.title} desc={d.desc} url={d.url} size={d.size} icon={d.icon} />)}
                </div>
              </details>

            </div>
          </section>

        </div><!-- /ev-grid -->
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
/* ── Grid container ──────────────────────────────────────── */
.ev-grid {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
  margin-top: 0.5rem;
}

/* ── Module card ─────────────────────────────────────────── */
.ev-card {
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.3);
  background: #243447;
  border: 1px solid #2d4a64;
  transition: box-shadow 0.25s;
}
.ev-card:hover {
  box-shadow: 0 6px 28px rgba(0, 0, 0, 0.45);
}

/* ── Card header (button) ────────────────────────────────── */
.ev-hdr {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding: 1.05rem 1.4rem;
  background: linear-gradient(
    to right,
    color-mix(in srgb, var(--mc) 20%, #1e293b) 0%,
    #243447 70%
  );
  border: none;
  cursor: pointer;
  text-align: left;
  border-left: 5px solid var(--mc, #10b981);
  transition: background 0.2s;
}
.ev-hdr:hover {
  background: linear-gradient(
    to right,
    color-mix(in srgb, var(--mc) 32%, #1e293b) 0%,
    #1e3050 70%
  );
}
.ev-card.open > .ev-hdr {
  border-bottom: 1px solid #2d4a64;
}

/* ── Badge (number) ──────────────────────────────────────── */
.ev-badge {
  background: var(--mc, #10b981);
  color: #fff;
  font-weight: 800;
  font-size: 0.8rem;
  padding: 0.28rem 0.6rem;
  border-radius: 7px;
  flex-shrink: 0;
  font-family: var(--font-mono);
  letter-spacing: 0.05em;
}

/* ── Module title ────────────────────────────────────────── */
.ev-ttl {
  font-size: 1.08rem;
  font-weight: 700;
  color: #f0f4f8;
  flex: 1;
}

/* ── File count chip ─────────────────────────────────────── */
.ev-count {
  font-size: 0.78rem;
  color: #64748b;
  font-weight: 500;
  white-space: nowrap;
  padding: 0.18rem 0.55rem;
  border: 1px solid #2d4a64;
  border-radius: 10px;
  background: #1e293b;
}

/* ── Chevron ─────────────────────────────────────────────── */
.ev-chevron {
  font-size: 0.85rem;
  color: var(--mc, #10b981);
  transition: transform 0.3s;
  flex-shrink: 0;
}
.ev-card.open .ev-chevron {
  transform: rotate(180deg);
}

/* ── Card body ───────────────────────────────────────────── */
.ev-body {
  display: none;
  padding: 1.4rem 1.5rem;
}
.ev-card.open > .ev-body {
  display: block;
}

/* ── Description box ─────────────────────────────────────── */
.ev-desc {
  font-size: 0.97rem;
  color: rgba(248, 250, 252, 0.75);
  line-height: 1.75;
  margin-bottom: 1.2rem;
  padding: 0.85rem 1.1rem;
  background: #1a2740;
  border-radius: 9px;
  border-left: 3px solid var(--mc, #10b981);
  max-width: 100%;
}

/* ── Placeholder ─────────────────────────────────────────── */
.placeholder-msg {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1.4rem 1.2rem;
  background: rgba(16, 185, 129, 0.04);
  border: 1px dashed rgba(16, 185, 129, 0.25);
  border-radius: 10px;
  color: rgba(248, 250, 252, 0.4);
  font-size: 0.95rem;
  font-style: italic;
}
.placeholder-msg p {
  margin: 0;
  max-width: none;
}
.placeholder-icon {
  font-size: 1.4rem;
  opacity: 0.5;
  flex-shrink: 0;
}

/* ── Proyecto card special styling ───────────────────────── */
.ev-hdr-proyecto {
  background: linear-gradient(to right, color-mix(in srgb, #fb923c 22%, #1e293b) 0%, #243447 100%);
  border-left-color: #fb923c;
}
.ev-hdr-proyecto:hover {
