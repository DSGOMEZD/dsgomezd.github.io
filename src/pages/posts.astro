                    </div>

                    <div class="file-row">
                      <span class="ftype pdf">PDF</span>
                      <span class="fname">Diccionario de Datos</span>
                      <div class="fbtns">
                        <button class="btn-prev" data-src="/evidencias/07-proyecto/PROYECTO_FINAL_BD1/Fase%201/Diccionario_Datos_UB_Deporte.pdf">Vista Previa</button>
                        <a class="btn-dl" href="/evidencias/07-proyecto/PROYECTO_FINAL_BD1/Fase%201/Diccionario_Datos_UB_Deporte.pdf" download>↓ Descargar</a>
