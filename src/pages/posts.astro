---
import fs from "node:fs";
import path from "node:path";
import "../styles/home.css";
import "../styles/posts.css";
import "../styles/page-transitions.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import SqlPreview from "../components/SqlPreview.astro";
import PdfPreview from "../components/PdfPreview.astro";

const PUBLIC_DIR = path.join(process.cwd(), "public");

function sqlPreview(relPath: string, lines = 14) {
  const filePath = path.join(PUBLIC_DIR, relPath);
  const content = fs.readFileSync(filePath, "utf-8");
  const allLines = content.split("\n");
  let preview = allLines.slice(0, lines).join("\n").trimEnd();
  if (allLines.length > lines) preview += "\n...";
  return { preview, totalLines: allLines.length, url: "/" + relPath };
}

function pdfInfo(relPath: string) {
  const filePath = path.join(PUBLIC_DIR, relPath);
  const stat = fs.statSync(filePath);
  const sizeMB = stat.size / (1024 * 1024);
  const size = sizeMB >= 1 ? `${sizeMB.toFixed(1)} MB` : `${Math.round(stat.size / 1024)} KB`;
  return { url: "/" + relPath, size };
}

const repasoSql = sqlPreview("evidencias/bd2/01-repaso-sql/REPASO_SQL.sql");
const avanzadoSql = sqlPreview("evidencias/bd2/02-sql-avanzado/SQL_AVANZADO.sql");
const transaccionesSql = sqlPreview("evidencias/bd2/03-transacciones/TRANSACCIONES.sql");
const optimizacionSql = sqlPreview("evidencias/bd2/04-optimizacion-indices/OPTIMIZACION.sql");
const indexacionSql = sqlPreview("evidencias/bd2/04-optimizacion-indices/INDEXACION.sql");
const tallerSql = sqlPreview("evidencias/bd2/05-talleres/SQL_completos.sql", 16);
const tallerPdf = pdfInfo("evidencias/bd2/05-talleres/Taller_BD2_MercaAndes_Respuestas.pdf");
const modeloPdf = pdfInfo("evidencias/bd2/08-proyecto/Modelo_de_datos_BD2.pdf");
const motogoSistemaPdf = pdfInfo("evidencias/bd2/08-proyecto/MotoGo_Sistema_Gestion_Alquiler_Motocicletas.pdf");
const motogoSupuestosPdf = pdfInfo("evidencias/bd2/08-proyecto/MotoGo_Supuestos_Desarrollo_Proyecto.pdf");
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Contenido — Bases de Datos II</title>
  </head>

  <body>
    <Navigation />

    <main class="posts-page">
      <div class="posts-container page-content">

        <div class="posts-header posts-header-animate">
          <h1 class="posts-title">Contenido BD II</h1>
          <p class="posts-subtitle">Bases de Datos II · Universidad del Bosque · 2025-2</p>
        </div>

        <div class="ev-grid posts-content-animate">

          <!-- ══ 01 REPASO SQL ═════════════════════════════════ -->
          <section class="ev-card" id="sql-repaso">
            <button class="ev-hdr" style="--mc:#10b981">
              <span class="ev-badge">01</span>
              <span class="ev-ttl">Repaso SQL</span>
              <span class="ev-count">1 script SQL</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Repaso de SQL fundamental sobre el esquema HR de Oracle: SELECT, WHERE, NULL,
                funciones de texto/numéricas/fecha, agregaciones, GROUP BY/HAVING, todos los
                tipos de JOIN (INNER, LEFT, RIGHT, FULL, SELF, CROSS), CASE, DECODE, subconsultas,
                EXISTS/IN, operadores de conjuntos (UNION, INTERSECT, MINUS) y vistas.
              </p>
              <SqlPreview preview={repasoSql.preview} totalLines={repasoSql.totalLines} url={repasoSql.url} />
            </div>
          </section>

          <!-- ══ 02 SQL AVANZADO ═══════════════════════════════ -->
          <section class="ev-card" id="sql-avanzado">
            <button class="ev-hdr" style="--mc:#38bdf8">
              <span class="ev-badge">02</span>
              <span class="ev-ttl">SQL Avanzado</span>
              <span class="ev-count">1 script SQL</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Expresiones de tabla comunes (CTE) simples y recursivas, funciones de ventana
                (ROW_NUMBER, RANK, DENSE_RANK, LAG/LEAD), acumulados y promedios móviles,
                RATIO_TO_REPORT, PERCENT_RANK, CUME_DIST y NTILE, jerarquías con CONNECT BY,
                PIVOT, LISTAGG, FETCH WITH TIES y MERGE, comparando soluciones con subconsultas
                frente a funciones analíticas.
              </p>
              <SqlPreview preview={avanzadoSql.preview} totalLines={avanzadoSql.totalLines} url={avanzadoSql.url} />
            </div>
          </section>

          <!-- ══ 03 TRANSACCIONES ══════════════════════════════ -->
          <section class="ev-card" id="transacciones">
            <button class="ev-hdr" style="--mc:#f472b6">
              <span class="ev-badge">03</span>
              <span class="ev-ttl">Transacciones</span>
              <span class="ev-count">1 script SQL</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Control transaccional en Oracle: COMMIT, ROLLBACK y SAVEPOINT, niveles de
                aislamiento READ COMMITTED y SERIALIZABLE, transacciones READ ONLY,
                SELECT ... FOR UPDATE con NOWAIT/WAIT, y prácticas de bloqueos, concurrencia
                y deadlocks usando dos sesiones simultáneas.
              </p>
              <SqlPreview preview={transaccionesSql.preview} totalLines={transaccionesSql.totalLines} url={transaccionesSql.url} />
            </div>
          </section>

          <!-- ══ 04 OPTIMIZACIÓN E INDEXACIÓN ══════════════════ -->
          <section class="ev-card" id="indexacion">
            <button class="ev-hdr" style="--mc:#fb923c">
              <span class="ev-badge">04</span>
              <span class="ev-ttl">Optimización e Indexación de Consultas</span>
              <span class="ev-count">2 scripts SQL</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Cómo el motor ejecuta las consultas por dentro: EXPLAIN PLAN y DBMS_XPLAN,
                costo y cardinalidad (E-Rows/A-Rows), GATHER_PLAN_STATISTICS, SARGabilidad,
                JOIN vs subconsulta, EXISTS, UNION vs UNION ALL. Y del lado de índices: simples,
                compuestos, function-based, selectividad, estadísticas con DBMS_STATS, índices
                invisibles y medición de rendimiento antes/después.
              </p>
              <SqlPreview label="SQL · Optimización" preview={optimizacionSql.preview} totalLines={optimizacionSql.totalLines} url={optimizacionSql.url} />
              <SqlPreview label="SQL · Indexación" preview={indexacionSql.preview} totalLines={indexacionSql.totalLines} url={indexacionSql.url} />
            </div>
          </section>

          <!-- ══ 05 TALLERES ═══════════════════════════════════ -->
          <section class="ev-card" id="talleres">
            <button class="ev-hdr" style="--mc:#a78bfa">
              <span class="ev-badge">05</span>
              <span class="ev-ttl">Talleres</span>
              <span class="ev-count">1 script + 1 PDF</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Taller integrador MercaAndes: control de concurrencia aplicado (actualizaciones
                perdidas, bloqueo pesimista con SELECT ... FOR UPDATE, niveles de aislamiento)
                resuelto sesión por sesión, con las respuestas razonadas de cada ejercicio y el
                documento de entrega del taller.
              </p>
              <SqlPreview label="SQL · Taller MercaAndes" preview={tallerSql.preview} totalLines={tallerSql.totalLines} url={tallerSql.url} />
              <PdfPreview title="Taller BD2 MercaAndes — Respuestas" url={tallerPdf.url} size={tallerPdf.size} />
            </div>
          </section>

          <!-- ══ 06 NOSQL Y MONGODB ════════════════════════════ -->
          <section class="ev-card" id="nosql-mongodb">
            <button class="ev-hdr" style="--mc:#34d399">
              <span class="ev-badge">06</span>
              <span class="ev-ttl">NoSQL y MongoDB</span>
              <span class="ev-count">Próximamente</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Panorama general del ecosistema NoSQL (Teorema CAP, BASE vs ACID, tipos de bases
                documentales, clave-valor, columnares y grafos) junto con MongoDB en la práctica:
                CRUD completo sobre documentos BSON y pipelines de agregación ($match, $group,
                $project, $lookup, $unwind). Se cubre hacia el final del semestre.
              </p>
              <div class="placeholder-msg">
                <span class="placeholder-icon">📂</span>
                <p>Contenido próximamente — las evidencias se agregarán durante el semestre.</p>
              </div>
            </div>
          </section>

          <!-- ══ 07 PL/SQL ══════════════════════════════════════ -->
          <section class="ev-card" id="plsql">
            <button class="ev-hdr" style="--mc:#facc15">
              <span class="ev-badge">07</span>
              <span class="ev-ttl">PL/SQL y Programación de Bases de Datos</span>
              <span class="ev-count">Próximamente</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Programación procedural dentro del motor de base de datos: bloques PL/SQL
                anónimos, stored procedures con parámetros IN/OUT/IN-OUT, funciones almacenadas,
                cursores explícitos e implícitos, triggers BEFORE/AFTER para auditoría y
                validación, manejo de excepciones y organización en paquetes. Implementación en Oracle.
              </p>
              <div class="placeholder-msg">
                <span class="placeholder-icon">📂</span>
                <p>Contenido próximamente — las evidencias se agregarán durante el semestre.</p>
              </div>
            </div>
          </section>

          <!-- ══ 08 PROYECTO FINAL BD2 ═════════════════════════ -->
          <section class="ev-card ev-card-proyecto" id="proyecto">
            <button class="ev-hdr ev-hdr-proyecto">
              <span class="ev-badge ev-badge-proyecto">08</span>
              <span class="ev-ttl">Proyecto Final — MotoGo</span>
              <span class="ev-count">3 PDF</span>
              <span class="ev-chevron ev-chevron-proyecto">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc ev-desc-proyecto">
                MotoGo: sistema para la gestión y alquiler flexible de motocicletas. Proyecto
                integrador del semestre, combinando bases de datos relacionales y NoSQL. Por
                ahora: el modelo de datos y los supuestos y alcance definidos para el desarrollo
                del sistema. Faltan la implementación, optimización y el análisis comparativo
                entre ambos paradigmas.
              </p>
              <PdfPreview title="Modelo de datos — BD2" url={modeloPdf.url} size={modeloPdf.size} />
              <PdfPreview title="MotoGo — Sistema para la Gestión y Alquiler de Motocicletas" url={motogoSistemaPdf.url} size={motogoSistemaPdf.size} />
              <PdfPreview title="MotoGo — Supuestos para el Desarrollo del Proyecto" url={motogoSupuestosPdf.url} size={motogoSupuestosPdf.size} />
            </div>
          </section>

        </div><!-- /ev-grid -->
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
/* ── Grid container ──────────────────────────────────────── */
.ev-grid {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
  margin-top: 0.5rem;
}

/* ── Module card ─────────────────────────────────────────── */
.ev-card {
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.3);
  background: #243447;
  border: 1px solid #2d4a64;
  transition: box-shadow 0.25s;
}
.ev-card:hover {
  box-shadow: 0 6px 28px rgba(0, 0, 0, 0.45);
}

/* ── Card header (button) ────────────────────────────────── */
.ev-hdr {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding: 1.05rem 1.4rem;
  background: linear-gradient(
    to right,
    color-mix(in srgb, var(--mc) 20%, #1e293b) 0%,
    #243447 70%
  );
  border: none;
  cursor: pointer;
  text-align: left;
  border-left: 5px solid var(--mc, #10b981);
  transition: background 0.2s;
}
.ev-hdr:hover {
  background: linear-gradient(
    to right,
    color-mix(in srgb, var(--mc) 32%, #1e293b) 0%,
    #1e3050 70%
  );
}
.ev-card.open > .ev-hdr {
  border-bottom: 1px solid #2d4a64;
}

/* ── Badge (number) ──────────────────────────────────────── */
.ev-badge {
  background: var(--mc, #10b981);
  color: #fff;
  font-weight: 800;
  font-size: 0.8rem;
  padding: 0.28rem 0.6rem;
  border-radius: 7px;
  flex-shrink: 0;
  font-family: var(--font-mono);
  letter-spacing: 0.05em;
}

/* ── Module title ────────────────────────────────────────── */
.ev-ttl {
  font-size: 1.08rem;
  font-weight: 700;
  color: #f0f4f8;
  flex: 1;
}

/* ── File count chip ─────────────────────────────────────── */
.ev-count {
  font-size: 0.78rem;
  color: #64748b;
  font-weight: 500;
  white-space: nowrap;
  padding: 0.18rem 0.55rem;
  border: 1px solid #2d4a64;
  border-radius: 10px;
  background: #1e293b;
}

/* ── Chevron ─────────────────────────────────────────────── */
.ev-chevron {
  font-size: 0.85rem;
  color: var(--mc, #10b981);
  transition: transform 0.3s;
  flex-shrink: 0;
}
.ev-card.open .ev-chevron {
  transform: rotate(180deg);
}

/* ── Card body ───────────────────────────────────────────── */
.ev-body {
  display: none;
  padding: 1.4rem 1.5rem;
}
.ev-card.open > .ev-body {
  display: block;
}

/* ── Description box ─────────────────────────────────────── */
.ev-desc {
  font-size: 0.97rem;
  color: rgba(248, 250, 252, 0.75);
  line-height: 1.75;
  margin-bottom: 1.2rem;
  padding: 0.85rem 1.1rem;
  background: #1a2740;
  border-radius: 9px;
  border-left: 3px solid var(--mc, #10b981);
  max-width: 100%;
}

/* ── Placeholder ─────────────────────────────────────────── */
.placeholder-msg {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1.4rem 1.2rem;
  background: rgba(16, 185, 129, 0.04);
  border: 1px dashed rgba(16, 185, 129, 0.25);
  border-radius: 10px;
  color: rgba(248, 250, 252, 0.4);
  font-size: 0.95rem;
  font-style: italic;
}
.placeholder-msg p {
  margin: 0;
  max-width: none;
}
.placeholder-icon {
  font-size: 1.4rem;
  opacity: 0.5;
  flex-shrink: 0;
}

/* ── Proyecto card special styling ───────────────────────── */
.ev-hdr-proyecto {
  background: linear-gradient(to right, color-mix(in srgb, #fb923c 22%, #1e293b) 0%, #243447 100%);
  border-left-color: #fb923c;
}
.ev-hdr-proyecto:hover {
  background: linear-gradient(to right, color-mix(in srgb, #fb923c 35%, #1e293b) 0%, #1e3050 100%);
}
.ev-badge-proyecto {
  background: linear-gradient(90deg, #fb923c, #38bdf8);
}
.ev-chevron-proyecto { color: #fb923c; }
.ev-desc-proyecto { border-left-color: #fb923c; }

/* ── Responsive ──────────────────────────────────────────── */
@media (max-width: 640px) {
  .ev-hdr  { padding: 0.9rem 1rem; gap: 0.6rem; }
  .ev-body { padding: 1rem; }
  .ev-ttl  { font-size: 0.97rem; }
  .ev-count { display: none; }
}
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const pc = document.querySelector(".page-content");
    if (pc) pc.classList.add("visible");
    document.querySelectorAll(".posts-header-animate, .posts-content-animate")
      .forEach((el) => el.classList.add("visible"));

    document.querySelectorAll(".ev-hdr").forEach((btn) => {
      btn.addEventListener("click", () => {
        btn.closest(".ev-card")?.classList.toggle("open");
      });
    });
  });
</script>
