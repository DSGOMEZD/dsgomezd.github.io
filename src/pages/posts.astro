---
import fs from "node:fs";
import path from "node:path";
import "../styles/home.css";
import "../styles/posts.css";
import "../styles/page-transitions.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import SqlPreview from "../components/SqlPreview.astro";
import PdfPreview from "../components/PdfPreview.astro";
import DocCard from "../components/DocCard.astro";
import Caso from "../components/Caso.astro";

const PUBLIC_DIR = path.join(process.cwd(), "public");

function sqlPreview(relPath: string, lines = 14) {
  const filePath = path.join(PUBLIC_DIR, relPath);
  const content = fs.readFileSync(filePath, "utf-8");
  const allLines = content.split("\n");
  let preview = allLines.slice(0, lines).join("\n").trimEnd();
  if (allLines.length > lines) preview += "\n...";
  return { preview, totalLines: allLines.length, url: "/" + relPath };
}

function pdfInfo(relPath: string) {
  const filePath = path.join(PUBLIC_DIR, relPath);
  const stat = fs.statSync(filePath);
  const sizeMB = stat.size / (1024 * 1024);
  const size = sizeMB >= 1 ? `${sizeMB.toFixed(1)} MB` : `${Math.round(stat.size / 1024)} KB`;
  return { url: "/" + relPath, size };
}

const repasoSql = sqlPreview("evidencias/bd2/01-repaso-sql/REPASO_SQL.sql");
const avanzadoSql = sqlPreview("evidencias/bd2/02-sql-avanzado/SQL_AVANZADO.sql");
const transaccionesSql = sqlPreview("evidencias/bd2/03-transacciones/TRANSACCIONES.sql");
const optimizacionSql = sqlPreview("evidencias/bd2/04-optimizacion-indices/OPTIMIZACION.sql");
const indexacionSql = sqlPreview("evidencias/bd2/04-optimizacion-indices/INDEXACION.sql");
const tallerSql = sqlPreview("evidencias/bd2/05-talleres/SQL_completos.sql", 16);
const tallerPdf = pdfInfo("evidencias/bd2/05-talleres/Taller_BD2_MercaAndes_Respuestas.pdf");

// Fragmento de un script (líneas desde..hasta, base 1): en el portafolio solo va el código
// que explica una decisión; el script completo se enlaza en GitHub.
function fragment(relPath: string, from: number, to: number) {
  const all = fs.readFileSync(path.join(PUBLIC_DIR, relPath), "utf-8").split("\n");
  return { preview: all.slice(from - 1, to).join("\n").trimEnd(), totalLines: all.length, url: "/" + relPath };
}

// Presentación de investigación (PDF) → tarjeta de documento
const inv = (relPath: string, title: string, desc: string, icon = "🔎") => ({ ...pdfInfo(relPath), title, desc, icon });

// ── 06 NoSQL y MongoDB ─────────────────────────────────────
const M = "evidencias/bd2/06-nosql-mongodb";
const mqlEsr = fragment(`${M}/taller-mql/taller_mql_mflix.js`, 195, 201);
const mqlBucket = fragment(`${M}/taller-mql/documentos_ejemplo_domicilios.js`, 121, 142);
const mqlPdf = pdfInfo(`${M}/taller-mql/Taller_MQL_Duran_Gomez.pdf`);
const mqlZip = pdfInfo(`${M}/taller-mql/Entrega_Taller_MQL.zip`);
const mqlEnunciado = pdfInfo(`${M}/Enunciado_Taller_MQL_Airbnb.pdf`);
const optA = fragment(`${M}/sustentacion/opcion_A.js`, 29, 39);
const optB = fragment(`${M}/sustentacion/opcion_B.js`, 24, 37);
const invMongo = [
  inv(`${M}/investigacion/patrones-y-antipatrones-de-esquema.pdf`, "Patrones y antipatrones de esquema", "Polymorphic, Outlier, Tree, Approximation y Archive (los que no usamos en el taller) y los errores de diseño más comunes.", "🧩"),
  inv(`${M}/investigacion/consultas-geoespaciales-mongodb.pdf`, "Consultas geoespaciales", "GeoJSON, índices 2dsphere, $geoWithin, $geoIntersects y $geoNear, aplicado al caso de la sustentación.", "📍"),
];

// ── 07 PL/SQL ──────────────────────────────────────────────
const L = "evidencias/bd2/07-plsql";
const plsqlTrigger = fragment(`${L}/taller/TALLER_PLSQL_SOLUCION.sql`, 1579, 1616);
const plsqlPdf = pdfInfo(`${L}/taller/Taller_PLSQL_Gomez_Herrera_Amortegui.pdf`);
const plsqlZip = pdfInfo(`${L}/taller/Entrega_Taller_PLSQL.zip`);
const invPlsql = [
  inv(`${L}/investigacion/feedback-optimizador-y-clustering-factor.pdf`, "Feedback del optimizador y clustering factor", "Cómo el optimizador corrige sus estimaciones y por qué la dispersión física de los datos decide si usa un índice.", "🔁"),
  inv(`${L}/investigacion/bulk-collect-y-forall.pdf`, "BULK COLLECT y FORALL", "Procesamiento masivo en PL/SQL: menos cambios de contexto entre el motor PL/SQL y el motor SQL.", "⚡"),
  inv(`${L}/investigacion/sql-dinamico-e-inyeccion-sql.pdf`, "SQL dinámico e inyección SQL", "EXECUTE IMMEDIATE, variables bind y DBMS_ASSERT para construir sentencias en ejecución de forma segura.", "🛡️"),
];

// ── 08 ETL ─────────────────────────────────────────────────
const E = "evidencias/bd2/08-etl";
const invEtl = [
  inv(`${E}/etl-y-elt-fundamentos.pdf`, "ETL y ELT: fundamentos", "Las tres fases, extracción completa vs incremental, ETL vs ELT y una propuesta de ETL para MotoGo.", "🔄"),
  inv(`${E}/calidad-y-limpieza-de-datos.pdf`, "Calidad y limpieza de datos", "Dimensiones de calidad, deduplicación con ROW_NUMBER y registro de rechazos con DML Error Logging.", "🧹"),
  inv(`${E}/bodega-de-datos-modelo-estrella-y-scd.pdf`, "Bodega de datos: modelo estrella y SCD", "Hechos y dimensiones, estrella vs copo de nieve y Slowly Changing Dimensions tipo 2.", "⭐"),
];
// ── Proyecto final MotoGo ──────────────────────────────────
const P = "evidencias/bd2/09-proyecto";
const proyecto = {
  github: "https://github.com/DSGOMEZD/PROYECTO-BD2",
  videoId: "XST3REPmFmA",
  zip: pdfInfo(`${P}/Entrega_Proyecto_BD2_MotoGo.zip`),
  erImg: `/${P}/modelado/Modelo_Entidad_Relacion.jpg`,
};

const doc = (file: string, title: string, desc: string, icon: string) => ({
  ...pdfInfo(`${P}/${file}`), title, desc, icon,
});

const grupos = [
  {
    nombre: "Gestión del proyecto",
    accent: "#fb923c",
    docs: [
      doc("gestion/Propuesta_Proyecto.pdf", "Propuesta de proyecto", "Problema, objetivos, alcance y resultados esperados de la plataforma MotoGo.", "🎯"),
      doc("gestion/Supuestos.pdf", "Supuestos", "Reglas de negocio, operativas y tecnológicas sobre las que se diseñó el sistema.", "📌"),
      doc("gestion/Metodologia_Scrum.pdf", "Metodología — Scrum", "Justificación de Scrum, roles, eventos y planificación de sprints semanales.", "🔄"),
      doc("gestion/Organizacion_Equipo.pdf", "Organización del equipo", "Roles, responsabilidades por capa y matriz RACI del equipo de tres integrantes.", "👥"),
      doc("gestion/Gestion_Riesgos.pdf", "Gestión de riesgos", "Identificación, evaluación y plan de respuesta a los riesgos técnicos y del equipo.", "⚠️"),
    ],
  },
  {
    nombre: "Análisis técnico",
    accent: "#38bdf8",
    docs: [
      doc("analisis/Analisis_Seleccion_RDBMS.pdf", "Selección del RDBMS", "Comparación ponderada de MySQL, PostgreSQL y MariaDB con seguridad como criterio principal.", "🗄️"),
      doc("analisis/Analisis_Seleccion_SO.pdf", "Selección del sistema operativo", "Evaluación de distribuciones Linux para las máquinas virtuales de los motores.", "🐧"),
    ],
  },
  {
    nombre: "Modelado de datos",
    accent: "#10b981",
    docs: [
      doc("modelado/Modelo_Relacional.pdf", "Modelo relacional", "Esquema relacional normalizado (3FN) de la base alquiler_motos.", "🔗"),
      doc("modelado/Modelo_Reducido_Tablas.pdf", "Modelo reducido a tablas", "Transformación del modelo E-R a tablas, llaves primarias y foráneas.", "📋"),
      doc("modelado/Diccionario_Datos.pdf", "Diccionario de datos", "Las 7 tablas y 67 columnas documentadas: tipos, restricciones y origen de cada llave.", "📖"),
    ],
  },
  {
    nombre: "Cierre",
    accent: "#a78bfa",
    docs: [
      doc("informe/Informe_Ejecutivo_Final.pdf", "Informe ejecutivo final", "Resumen de lo realmente construido: arquitectura, despliegue, resultados y aprendizajes.", "🏁"),
    ],
  },
];
const totalDocs = grupos.reduce((n, g) => n + g.docs.length, 0);

const stack = ["MySQL 8", "MongoDB 7", "Spring Boot", "Lubuntu", "VirtualBox", "Docker", "Tailscale VPN", "Scrum · Jira"];
const equipo = [
  { nombre: "David Santiago Gómez", rol: "Base de datos relacional · Scrum · Frontend" },
  { nombre: "Gabriel Amórtegui", rol: "Backend e integración web" },
  { nombre: "Daniel Nieto", rol: "MongoDB · Infraestructura Linux" },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Contenido — Bases de Datos II</title>
  </head>

  <body>
    <Navigation />

    <main class="posts-page">
      <div class="posts-container page-content">

        <div class="posts-header posts-header-animate">
          <h1 class="posts-title">Contenido BD II</h1>
          <p class="posts-subtitle">Bases de Datos II · Universidad del Bosque · 2025-2</p>
        </div>

        <div class="ev-grid posts-content-animate">

          <!-- ══ 01 REPASO SQL ═════════════════════════════════ -->
          <section class="ev-card" id="sql-repaso">
            <button class="ev-hdr" style="--mc:#10b981">
              <span class="ev-badge">01</span>
              <span class="ev-ttl">Repaso SQL</span>
              <span class="ev-count">1 script SQL</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Repaso de SQL fundamental sobre el esquema HR de Oracle: SELECT, WHERE, NULL,
                funciones de texto/numéricas/fecha, agregaciones, GROUP BY/HAVING, todos los
                tipos de JOIN (INNER, LEFT, RIGHT, FULL, SELF, CROSS), CASE, DECODE, subconsultas,
                EXISTS/IN, operadores de conjuntos (UNION, INTERSECT, MINUS) y vistas.
              </p>
              <SqlPreview preview={repasoSql.preview} totalLines={repasoSql.totalLines} url={repasoSql.url} />
            </div>
          </section>

          <!-- ══ 02 SQL AVANZADO ═══════════════════════════════ -->
          <section class="ev-card" id="sql-avanzado">
            <button class="ev-hdr" style="--mc:#38bdf8">
              <span class="ev-badge">02</span>
              <span class="ev-ttl">SQL Avanzado</span>
              <span class="ev-count">1 script SQL</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Expresiones de tabla comunes (CTE) simples y recursivas, funciones de ventana
                (ROW_NUMBER, RANK, DENSE_RANK, LAG/LEAD), acumulados y promedios móviles,
                RATIO_TO_REPORT, PERCENT_RANK, CUME_DIST y NTILE, jerarquías con CONNECT BY,
                PIVOT, LISTAGG, FETCH WITH TIES y MERGE, comparando soluciones con subconsultas
                frente a funciones analíticas.
              </p>
              <SqlPreview preview={avanzadoSql.preview} totalLines={avanzadoSql.totalLines} url={avanzadoSql.url} />
            </div>
          </section>

          <!-- ══ 03 TRANSACCIONES ══════════════════════════════ -->
          <section class="ev-card" id="transacciones">
            <button class="ev-hdr" style="--mc:#f472b6">
              <span class="ev-badge">03</span>
              <span class="ev-ttl">Transacciones</span>
              <span class="ev-count">1 script SQL</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Control transaccional en Oracle: COMMIT, ROLLBACK y SAVEPOINT, niveles de
                aislamiento READ COMMITTED y SERIALIZABLE, transacciones READ ONLY,
                SELECT ... FOR UPDATE con NOWAIT/WAIT, y prácticas de bloqueos, concurrencia
                y deadlocks usando dos sesiones simultáneas.
              </p>
              <SqlPreview preview={transaccionesSql.preview} totalLines={transaccionesSql.totalLines} url={transaccionesSql.url} />
            </div>
          </section>

          <!-- ══ 04 OPTIMIZACIÓN E INDEXACIÓN ══════════════════ -->
          <section class="ev-card" id="indexacion">
            <button class="ev-hdr" style="--mc:#fb923c">
              <span class="ev-badge">04</span>
              <span class="ev-ttl">Optimización e Indexación de Consultas</span>
              <span class="ev-count">2 scripts SQL</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Cómo el motor ejecuta las consultas por dentro: EXPLAIN PLAN y DBMS_XPLAN,
                costo y cardinalidad (E-Rows/A-Rows), GATHER_PLAN_STATISTICS, SARGabilidad,
                JOIN vs subconsulta, EXISTS, UNION vs UNION ALL. Y del lado de índices: simples,
                compuestos, function-based, selectividad, estadísticas con DBMS_STATS, índices
                invisibles y medición de rendimiento antes/después.
              </p>
              <SqlPreview label="SQL · Optimización" preview={optimizacionSql.preview} totalLines={optimizacionSql.totalLines} url={optimizacionSql.url} />
              <SqlPreview label="SQL · Indexación" preview={indexacionSql.preview} totalLines={indexacionSql.totalLines} url={indexacionSql.url} />
            </div>
          </section>

          <!-- ══ 05 TALLERES ═══════════════════════════════════ -->
          <section class="ev-card" id="talleres">
            <button class="ev-hdr" style="--mc:#a78bfa">
              <span class="ev-badge">05</span>
              <span class="ev-ttl">Talleres</span>
              <span class="ev-count">1 script + 1 PDF</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Taller integrador MercaAndes: control de concurrencia aplicado (actualizaciones
                perdidas, bloqueo pesimista con SELECT ... FOR UPDATE, niveles de aislamiento)
                resuelto sesión por sesión, con las respuestas razonadas de cada ejercicio y el
                documento de entrega del taller.
              </p>
              <SqlPreview label="SQL · Taller MercaAndes" preview={tallerSql.preview} totalLines={tallerSql.totalLines} url={tallerSql.url} />
              <PdfPreview title="Taller BD2 MercaAndes — Respuestas" url={tallerPdf.url} size={tallerPdf.size} />
            </div>
          </section>

          <!-- ══ 06 NOSQL Y MONGODB ════════════════════════════ -->
          <section class="ev-card" id="nosql-mongodb">
            <button class="ev-hdr" style="--mc:#34d399">
              <span class="ev-badge">06</span>
              <span class="ev-ttl">NoSQL y MongoDB</span>
              <span class="ev-count">2 talleres · {invMongo.length} investigaciones</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body" style="--mc:#34d399">
              <p class="ev-desc">
                MongoDB en la práctica sobre los datasets de ejemplo de Atlas: consultas con
                <code>find</code>, pipelines de agregación, escritura masiva, índices con la regla ESR
                y modelado documental con patrones de diseño. Los scripts completos están en el
                repositorio; aquí se resume qué se buscaba, cómo se resolvió y qué se aprendió.
              </p>

              <Caso
                titulo="Taller MQL — consultas, agregación, índices y modelado"
                meta="sample_mflix · Mariana Durán y Santiago Gómez"
                contexto="Taller de 14 puntos sobre la colección de películas de sample_mflix, más una parte de modelado con dos casos: una plataforma de domicilios y el monitoreo IoT de la calidad del aire en Bogotá."
                objetivo="Dominar find y aggregate sobre documentos con arreglos y objetos anidados, medir el efecto de un índice con explain() y diseñar esquemas justificando cada patrón documental."
                solucion={[
                  "Antes de promediar ratings se filtran los valores vacíos con <code>$type: \"number\"</code>, porque el campo mezcla números y cadenas.",
                  "En el top de películas comentadas se agrupa y se limita a 10 <em>antes</em> del <code>$lookup</code>: la unión se hace 10 veces y no una por película.",
                  "Índice compuesto siguiendo <strong>ESR</strong> (Equality → Sort → Range): <code>genres</code>, luego <code>imdb.rating</code> y al final <code>year</code>.",
                  "Modelado con Extended Reference, Subset, Computed, Attribute, Bucket y Schema Versioning, cada uno con su costo y lo que pasaría sin él.",
                ]}
                resultados={[
                  "Con el índice el plan ganador pasa de <code>COLLSCAN</code> a <code>IXSCAN</code> y baja mucho <code>totalDocsExamined</code>.",
                  "El patrón Bucket reduce de 288.000 a 4.800 documentos diarios en el caso IoT (60 veces menos).",
                  "Dos modelos completos en Hackolade con documentos de ejemplo e índices propuestos.",
                ]}
                aprendizajes={[
                  "El orden de las etapas del pipeline cambia el costo tanto como un índice.",
                  "En MongoDB el esquema se diseña desde las consultas, aceptando algo de duplicación.",
                  "Guardar suma y conteo (no solo el promedio) permite combinar promedios sin error.",
                ]}
              >
                <SqlPreview label="MQL · Índice ESR (punto 14)" preview={mqlEsr.preview} totalLines={mqlEsr.totalLines} url={mqlEsr.url} />
                <SqlPreview label="Patrón Bucket · lecturas por hora" preview={mqlBucket.preview} totalLines={mqlBucket.totalLines} url={mqlBucket.url} />
                <div class="ev-files">
                  <PdfPreview title="Taller MQL — documento de entrega" url={mqlPdf.url} size={mqlPdf.size} />
                  <a class="ev-file" href={mqlZip.url} download>⬇ Entrega completa con modelos Hackolade (.zip · {mqlZip.size})</a>
                  <a class="ev-file" href={mqlEnunciado.url} target="_blank" rel="noopener">📄 Enunciado del taller MQL CRUD (sample_airbnb) ↗</a>
                </div>
              </Caso>

              <Caso
                titulo="Sustentación — restaurantes por barrio (opción A y opción B)"
                meta="sample_restaurants · Mariana Durán y Santiago Gómez"
                contexto="En la sustentación se pidieron tres consultas: restaurantes de Manhattan con calificación A, cantidad de restaurantes por barrio y el top 5 de barrios. Los restaurantes solo tienen un punto y los barrios un polígono GeoJSON, así que no existe un campo “barrio” para agrupar."
                objetivo="Relacionar dos colecciones por ubicación: un restaurante pertenece a un barrio si su punto cae dentro del polígono ($geoWithin). Se resolvió de dos maneras para comparar."
                solucion={[
                  "<strong>Opción A</strong>: por cada barrio se ejecuta <code>countDocuments</code> con <code>$geoWithin</code> y el resultado se ordena en JavaScript. No crea nada nuevo, pero repite todas las consultas para el punto 2 y para el 3.",
                  "<strong>Opción B</strong>: se recorre los barrios una sola vez y con <code>$merge</code> se guarda cada restaurante con su barrio en <code>restaurantes_por_barrio</code>. Después los puntos 2 y 3 son un <code>$group</code> normal.",
                  "<code>grades.0</code> se usa como la calificación más reciente para el punto 1.",
                ]}
                resultados={[
                  "Las tres consultas quedaron resueltas con las dos estrategias.",
                  "B paga el costo geoespacial una vez; A lo paga en cada consulta.",
                ]}
                aprendizajes={[
                  "<code>$merge</code> sin <code>on</code> une por <code>_id</code>: si un restaurante cayera en dos polígonos, en B quedaría solo con el último barrio, mientras que A lo contaría en ambos.",
                  "Es la misma decisión que una vista frente a una vista materializada en SQL: espacio a cambio de tiempo.",
                  "Una colección materializada hay que borrarla o refrescarla cuando cambian los datos.",
                ]}
              >
                <SqlPreview label="Opción A · contar en el cliente" preview={optA.preview} totalLines={optA.totalLines} url={optA.url} />
                <SqlPreview label="Opción B · materializar con $merge" preview={optB.preview} totalLines={optB.totalLines} url={optB.url} />
              </Caso>

              <h4 class="inv-title">🔎 Investigación</h4>
              <div class="pj-docs">
                {invMongo.map((d) => <DocCard title={d.title} desc={d.desc} url={d.url} size={d.size} icon={d.icon} />)}
              </div>
            </div>
          </section>

          <!-- ══ 07 PL/SQL ══════════════════════════════════════ -->
          <section class="ev-card" id="plsql">
            <button class="ev-hdr" style="--mc:#facc15">
              <span class="ev-badge">07</span>
              <span class="ev-ttl">PL/SQL y Programación de Bases de Datos</span>
              <span class="ev-count">1 taller · {invPlsql.length} investigaciones</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body" style="--mc:#facc15">
              <p class="ev-desc">
                Programación procedural dentro de Oracle: procedimientos, funciones, cursores,
                excepciones, disparadores y paquetes sobre un esquema de inventario y ventas.
                Cada objeto se entregó con su justificación de diseño y su análisis ante
                concurrencia, volumen y error.
              </p>

              <Caso
                titulo="Taller PL/SQL — inventario y ventas"
                meta="Oracle · Grupo 3: Santiago Gómez, Gabriel Amórtegui, David Herrera"
                contexto="Taller de 6 partes (50 puntos) sobre un esquema de productos, clientes, pedidos y movimientos de stock. La calificación pesaba tanto la justificación (40 %) como que el código funcionara (40 %)."
                objetivo="Llevar las reglas de negocio al motor: registrar productos, ajustar stock, crear y facturar pedidos, validar cupo de crédito y mantener totales y auditoría con disparadores."
                solucion={[
                  "El stock se lee con <code>SELECT ... FOR UPDATE</code> para que dos ajustes simultáneos no pisen el mismo saldo.",
                  "<code>SP_REGISTRAR_ERROR</code> usa <code>PRAGMA AUTONOMOUS_TRANSACTION</code>: el log de errores persiste aunque la operación principal haga ROLLBACK.",
                  "El total del pedido se recalcula con un <strong>COMPOUND TRIGGER</strong>: el primer intento con trigger de fila produjo ORA-04091 (tabla mutante).",
                  "Un trigger <code>INSTEAD OF</code> permite actualizar precio y stock mínimo a través de una vista que no es actualizable.",
                  "<code>PKG_VENTAS.SP_FACTURAR_PEDIDO</code> reutiliza las funciones anteriores, usa SAVEPOINT y deja el COMMIT al llamador.",
                ]}
                resultados={[
                  "Objetos compilados y probados: 7 procedimientos, 4 funciones, 6 disparadores y un paquete.",
                  "Cada objeto con código de prueba y su justificación en el mismo script.",
                ]}
                aprendizajes={[
                  "Un trigger de fila no puede consultar la tabla que está modificando; el compound trigger separa “anotar” de “recalcular”.",
                  "Dónde va el COMMIT es una decisión de diseño: dentro del paquete quitaría el control al que lo llama.",
                  "Los bloqueos (FOR UPDATE) se deciden pensando en dos usuarios a la vez, no en uno.",
                ]}
              >
                <SqlPreview label="PL/SQL · Compound trigger contra la tabla mutante" preview={plsqlTrigger.preview} totalLines={plsqlTrigger.totalLines} url={plsqlTrigger.url} />
                <div class="ev-files">
                  <PdfPreview title="Taller PL/SQL — documento de entrega" url={plsqlPdf.url} size={plsqlPdf.size} />
                  <a class="ev-file" href={plsqlZip.url} download>⬇ Entrega completa (.zip · {plsqlZip.size})</a>
                </div>
              </Caso>

              <h4 class="inv-title">🔎 Investigación</h4>
              <div class="pj-docs">
                {invPlsql.map((d) => <DocCard title={d.title} desc={d.desc} url={d.url} size={d.size} icon={d.icon} />)}
              </div>
            </div>
          </section>

          <!-- ══ 08 ETL ═════════════════════════════════════════ -->
          <section class="ev-card" id="etl">
            <button class="ev-hdr" style="--mc:#2dd4bf">
              <span class="ev-badge">08</span>
              <span class="ev-ttl">ETL — Extracción, Transformación y Carga</span>
              <span class="ev-count">{invEtl.length} investigaciones</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body" style="--mc:#2dd4bf">
              <p class="ev-desc">
                Tema trabajado como investigación: cómo se mueven los datos desde las bases que
                operan el negocio hasta una bodega pensada para analizar. Cada presentación conecta
                el tema con lo visto en clase (MERGE, funciones de ventana, <code>$merge</code> de
                MongoDB) y con una propuesta aplicada al proyecto MotoGo.
              </p>
              <div class="pj-docs">
                {invEtl.map((d) => <DocCard title={d.title} desc={d.desc} url={d.url} size={d.size} icon={d.icon} />)}
