  <body>
    <Navigation />

    <main class="posts-page">
      <div class="posts-container page-content">

        <div class="posts-header posts-header-animate">
          <h1 class="posts-title">Evidencias BD I</h1>
          <p class="posts-subtitle">Bases de Datos I · Universidad del Bosque · 2025-1</p>
        </div>

        <div class="ev-grid posts-content-animate">

          <!-- ══ 01 MODELO ENTIDAD RELACIÓN Y MERE ══════════════════ -->
          <section class="ev-card" id="mer">
            <button class="ev-hdr" style="--mc:#76cfc5">
              <span class="ev-badge">01</span>
              <span class="ev-ttl">Modelo Entidad Relación y MERE</span>
              <span class="ev-count">6 archivos</span>
              <span class="ev-chevron">▼</span>
            </button>
            <div class="ev-body">
              <p class="ev-desc">
                Representación gráfica de entidades, atributos y relaciones de una base de datos.
                El Modelo Extendido (MERE) añade conceptos de especialización, generalización y
                agregación para representar estructuras más complejas.
              </p>
              <div class="file-list">

                <div class="file-row">
                  <span class="ftype pdf">PDF</span>
                  <span class="fname">Taller Grupal — Primer Taller Entregado</span>
                  <span class="ftag taller">Taller Grupal</span>
                  <div class="fbtns">
                    <button class="btn-prev" data-src="/evidencias/01-modelo-entidad-relacion/EJERCICIOS%20TALLER%20GRUPAL.pdf">Vista Previa</button>
                    <a class="btn-dl" href="/evidencias/01-modelo-entidad-relacion/EJERCICIOS%20TALLER%20GRUPAL.pdf" download>↓ Descargar</a>
                  </div>
                  <div class="pdf-wrap" hidden>
                    <iframe class="pdf-fr" title="Taller Grupal MER"></iframe>
                  </div>
                </div>

                <div class="file-row">
                  <span class="ftype pdf">PDF</span>
                  <span class="fname">Modelo Aerolínea</span>
                  <span class="ftag practica">Práctica</span>
                  <div class="fbtns">
                    <button class="btn-prev" data-src="/evidencias/01-modelo-entidad-relacion/MODELO%20AEROLINEA.pdf">Vista Previa</button>
                    <a class="btn-dl" href="/evidencias/01-modelo-entidad-relacion/MODELO%20AEROLINEA.pdf" download>↓ Descargar</a>
                  </div>
                  <div class="pdf-wrap" hidden>
                    <iframe class="pdf-fr" title="Modelo Aerolínea"></iframe>
                  </div>
                </div>

                <div class="file-row">
                  <span class="ftype pdf">PDF</span>
                  <span class="fname">Modelo Hospital</span>
                  <span class="ftag practica">Práctica</span>
                  <div class="fbtns">
                    <button class="btn-prev" data-src="/evidencias/01-modelo-entidad-relacion/MODELO%20HOSPITAL.pdf">Vista Previa</button>
                    <a class="btn-dl" href="/evidencias/01-modelo-entidad-relacion/MODELO%20HOSPITAL.pdf" download>↓ Descargar</a>
                  </div>
                  <div class="pdf-wrap" hidden>
                    <iframe class="pdf-fr" title="Modelo Hospital"></iframe>
                  </div>
                </div>

                <div class="file-row">
                  <span class="ftype pdf">PDF</span>
                  <span class="fname">Taller MER E-R</span>
                  <span class="ftag practica">Práctica</span>
                  <div class="fbtns">
                    <button class="btn-prev" data-src="/evidencias/01-modelo-entidad-relacion/TALLER%20MER%20E-R.pdf">Vista Previa</button>
                    <a class="btn-dl" href="/evidencias/01-modelo-entidad-relacion/TALLER%20MER%20E-R.pdf" download>↓ Descargar</a>
                  </div>
                  <div class="pdf-wrap" hidden>
                    <iframe class="pdf-fr" title="Taller MER E-R"></iframe>
                  </div>
                </div>

                <div class="file-row">
                  <span class="ftype pdf">PDF</span>
                  <span class="fname">Taller MER V4</span>
                  <span class="ftag practica">Práctica</span>
                  <div class="fbtns">
                    <button class="btn-prev" data-src="/evidencias/01-modelo-entidad-relacion/TALLER%20MER_V4.pdf">Vista Previa</button>
                    <a class="btn-dl" href="/evidencias/01-modelo-entidad-relacion/TALLER%20MER_V4.pdf" download>↓ Descargar</a>
                  </div>
                  <div class="pdf-wrap" hidden>
                    <iframe class="pdf-fr" title="Taller MER V4"></iframe>
                  </div>
                </div>

                <div class="file-row">
                  <span class="ftype pdf">PDF</span>
                  <span class="fname">Taller MERE V3 — Modelo Extendido</span>
                  <span class="ftag practica">Práctica</span>
                  <div class="fbtns">
                    <button class="btn-prev" data-src="/evidencias/01-modelo-entidad-relacion/Taller_MERE_v3.pdf">Vista Previa</button>
