<script>
  document.addEventListener("DOMContentLoaded", () => {
    const pc = document.querySelector(".page-content");
    if (pc) pc.classList.add("visible");
    document.querySelectorAll(".posts-header-animate, .posts-content-animate")
      .forEach((el) => el.classList.add("visible"));

    // Accordion
    document.querySelectorAll(".ev-hdr").forEach((btn) => {
      btn.addEventListener("click", () => {
        btn.closest(".ev-card")?.classList.toggle("open");
      });
    });

    // PDF preview — lazy loads src only when first opened
    document.querySelectorAll(".btn-prev").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const row  = btn.closest(".file-row");
        const wrap = row ? row.querySelector(".pdf-wrap") : null;
        const fr   = wrap ? wrap.querySelector(".pdf-fr") : null;
        if (!wrap || !fr) return;
        const closing = !wrap.hidden;
        wrap.hidden = closing;
        if (!closing && !fr.src) {
          fr.src = btn.dataset.src || "";
        }
        btn.textContent = closing ? "Vista Previa" : "Cerrar";
      });
    });
  });
</script>
