                      <span class="fname">Álgebra Relacional — UB-Deportes</span>
                      <div class="fbtns">
                        <button class="btn-prev" data-src="/evidencias/07-proyecto/PROYECTO_FINAL_BD1/Fase%201/Algebra_Relacional_UB-Deportes.pdf">Vista Previa</button>
