                  </a>
                </div>
              </div>

              <!-- Video demostrativo -->
              <h4 class="pj-section">🎬 Video demostrativo</h4>
              <div class="pj-video">
                <iframe
                  src={`https://www.youtube.com/embed/${proyecto.videoId}`}
                  title="MotoGo — video demostrativo"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>

              <!-- Equipo -->
              <h4 class="pj-section">👥 Equipo</h4>
              <div class="pj-team">
                {equipo.map((m) => (
                  <div class="pj-member">
                    <span class="pj-avatar">{m.nombre.split(" ").filter((_, i, a) => i === 0 || i === a.length - 1).map((w) => w[0]).join("")}</span>
                    <div>
                      <strong>{m.nombre}</strong>
                      <span>{m.rol}</span>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Modelo E-R -->
              <h4 class="pj-section">🧩 Modelo Entidad–Relación</h4>
              <a href={proyecto.erImg} target="_blank" rel="noopener" class="pj-er">
