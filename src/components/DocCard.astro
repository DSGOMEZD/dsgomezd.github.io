---
// Tarjeta compacta de documento: el PDF solo se carga al pulsar "Vista previa".
interface Props {
  title: string;
  desc: string;
  url: string;
  size: string;
  icon?: string;
}
const { title, desc, url, size, icon = "📄" } = Astro.props;
---

<article class="doc-card">
  <div class="doc-main">
    <span class="doc-icon">{icon}</span>
    <div class="doc-info">
      <h4 class="doc-title">{title}</h4>
      <p class="doc-desc">{desc}</p>
    </div>
  </div>
  <div class="doc-actions">
    <span class="doc-size">PDF · {size}</span>
    <button type="button" class="doc-btn doc-preview-btn" data-src={url}>Vista previa</button>
    <a href={url} target="_blank" rel="noopener" class="doc-btn doc-open">Abrir ↗</a>
  </div>
  <div class="doc-frame-wrap" hidden></div>
</article>

<style>
  .doc-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 1.05rem;
    background: #1a2740;
    border: 1px solid #2d4a64;
    border-radius: 11px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .doc-card:hover {
    border-color: color-mix(in srgb, var(--accent, #fb923c) 55%, #2d4a64);
    transform: translateY(-2px);
  }
  .doc-card.expanded {
    grid-column: 1 / -1;
    transform: none;
  }
  .doc-main {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    flex: 1;
  }
  .doc-icon {
    font-size: 1.35rem;
    line-height: 1;
    padding: 0.45rem;
    border-radius: 9px;
    background: color-mix(in srgb, var(--accent, #fb923c) 14%, transparent);
    flex-shrink: 0;
  }
  .doc-info { min-width: 0; }
  .doc-title {
    margin: 0 0 0.25rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #f0f4f8;
  }
  .doc-desc {
    margin: 0;
    font-size: 0.83rem;
    line-height: 1.55;
    color: rgba(248, 250, 252, 0.62);
    max-width: none;
  }
  .doc-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .doc-size {
    font-size: 0.72rem;
    color: #64748b;
    margin-right: auto;
  }
  .doc-btn {
    font-size: 0.78rem;
    font-weight: 600;
    font-family: inherit;
    padding: 0.32rem 0.7rem;
    border-radius: 7px;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s;
  }
  .doc-preview-btn {
    color: #f0f4f8;
    background: #243447;
    border: 1px solid #2d4a64;
  }
  .doc-preview-btn:hover { background: #2d4a64; }
  .doc-open {
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }
  .doc-open:hover {
    background: rgba(56, 189, 248, 0.1);
    border-color: rgba(56, 189, 248, 0.6);
  }
  .doc-frame-wrap :global(iframe) {
    width: 100%;
    height: 520px;
    border: none;
    border-radius: 8px;
    display: block;
    background: #0f1c2e;
  }
  @media (max-width: 640px) {
    .doc-frame-wrap :global(iframe) { height: 360px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".doc-preview-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const card = btn.closest(".doc-card");
      const wrap = card?.querySelector<HTMLDivElement>(".doc-frame-wrap");
      if (!card || !wrap) return;
      if (!wrap.firstElementChild) {
        const frame = document.createElement("iframe");
        frame.src = btn.dataset.src ?? "";
        frame.title = card.querySelector(".doc-title")?.textContent ?? "Documento";
        wrap.appendChild(frame);
      }
      const show = wrap.hidden;
      wrap.hidden = !show;
      card.classList.toggle("expanded", show);
      btn.textContent = show ? "Ocultar" : "Vista previa";
    });
  });
</script>
