---
interface Props {
  title: string;
  url: string;
  size: string;
}
const { title, url, size } = Astro.props;
---

<div class="pdf-card">
  <div class="pdf-card-hdr">
    <span class="pdf-icon">📄</span>
    <div class="pdf-card-info">
      <span class="pdf-title">{title}</span>
      <span class="pdf-size">{size}</span>
    </div>
    <a href={url} target="_blank" rel="noopener" class="ev-link">Abrir ↗</a>
  </div>
  <iframe src={url} class="pdf-frame" loading="lazy" title={title}></iframe>
</div>

<style>
  .pdf-card {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #2d4a64;
    background: #0f1c2e;
    margin-bottom: 1rem;
  }
  .pdf-card:last-child { margin-bottom: 0; }
  .pdf-card-hdr {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.9rem;
    background: #16263c;
    border-bottom: 1px solid #2d4a64;
  }
  .pdf-icon { font-size: 1.2rem; flex-shrink: 0; }
  .pdf-card-info {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .pdf-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: #f0f4f8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pdf-size {
    font-size: 0.72rem;
    color: #64748b;
  }
  .ev-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: #38bdf8;
    text-decoration: none;
    padding: 0.35rem 0.7rem;
    border-radius: 7px;
    border: 1px solid rgba(56, 189, 248, 0.3);
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.2s, border-color 0.2s;
  }
  .ev-link:hover {
    background: rgba(56, 189, 248, 0.1);
    border-color: rgba(56, 189, 248, 0.6);
  }
  .pdf-frame {
    width: 100%;
    height: 420px;
    border: none;
    display: block;
    background: #1a2740;
  }
  @media (max-width: 640px) {
    .pdf-frame { height: 320px; }
  }
</style>
